//@version=6
// =============================================================================
//  GOLD MASTER STRATEGY v2 — XAUUSD
//  Stratégie de tendance + momentum (refonte : plus active & robuste)
//  Auteur : Équipe Trading
//
//  CE QUI A CHANGÉ vs v1 :
//   - Entrée sur CROISEMENT des EMA rapide/lente (signal fréquent et fiable)
//     au lieu de "close croise EMA rapide" combiné à 6 filtres simultanés
//     (qui ne donnait quasi aucun trade).
//   - Tous les filtres (tendance 200, HTF, ADX, RSI, session) sont OPTIONNELS
//     et désactivables, pour pouvoir optimiser pas à pas.
//   - SORTIE sur signal opposé en plus du Stop/TP (les trades se clôturent).
//   - Réglages par défaut volontairement PERMISSIFS pour générer assez de
//     trades, puis on resserre selon le backtest.
//
//  Time frame recommandé : 15 min (intraday) ou 1H.
// =============================================================================

strategy(
     title              = "Gold Master Strategy v2 — XAUUSD",
     shorttitle         = "GOLD-MASTER-v2",
     overlay            = true,
     pyramiding         = 0,
     initial_capital    = 10000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 100,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.01,
     slippage           = 1,
     calc_on_every_tick = false,
     process_orders_on_close = true)

// =============================================================================
//  ENTRÉES / PARAMÈTRES
// =============================================================================

// --- Tendance (signal principal) ---
grpTrend   = "1) Tendance (signal)"
emaFastLen = input.int(20,  "EMA rapide", minval = 1, group = grpTrend)
emaSlowLen = input.int(50,  "EMA lente",  minval = 1, group = grpTrend)

// --- Filtres optionnels ---
grpFilt    = "2) Filtres (optionnels)"
useTrend200= input.bool(true,  "Filtre EMA 200 (sens du marché)", group = grpFilt)
emaTrendLen= input.int(200, "EMA de fond", minval = 1, group = grpFilt)
useHTF     = input.bool(false, "Filtre tendance supérieure (HTF)", group = grpFilt)
htfTf      = input.timeframe("240", "Time frame supérieur", group = grpFilt)
useRsi     = input.bool(false, "Filtre RSI", group = grpFilt)
rsiLen     = input.int(14, "RSI longueur", minval = 1, group = grpFilt)
rsiMid     = input.int(50, "RSI seuil (milieu)", minval = 1, maxval = 100, group = grpFilt)
useAdx     = input.bool(true,  "Filtre force de tendance (ADX)", group = grpFilt)
adxLen     = input.int(14, "ADX longueur", minval = 1, group = grpFilt)
adxMin     = input.float(18, "ADX minimum", minval = 0, group = grpFilt)

// --- Risque / Gestion de position ---
grpRisk    = "3) Gestion du risque"
atrLen     = input.int(14,   "ATR longueur", minval = 1, group = grpRisk)
atrStopMult= input.float(2.0,"Multiplicateur ATR (Stop)", minval = 0.1, step = 0.1, group = grpRisk)
rrRatio    = input.float(1.8,"Ratio Risque/Récompense (TP)", minval = 0.1, step = 0.1, group = grpRisk)
exitOpp    = input.bool(true,"Sortie sur signal opposé", group = grpRisk)
useTrail   = input.bool(false,"Activer trailing stop (ATR)", group = grpRisk)
trailMult  = input.float(2.5,"Multiplicateur ATR (Trailing)", minval = 0.1, step = 0.1, group = grpRisk)
riskPct    = input.float(1.0,"Risque par trade (% du capital)", minval = 0.1, step = 0.1, group = grpRisk)

// --- Filtre de session ---
grpSess    = "4) Sessions"
useSession = input.bool(false, "Trader uniquement sur une plage horaire", group = grpSess)
sessionStr = input.session("0700-2000", "Plage horaire (heure du graphique)", group = grpSess)

// --- Filtre de date ---
grpDate    = "5) Plage de dates (backtest)"
useDate    = input.bool(false, "Limiter la plage de dates", group = grpDate)
startDate  = input.time(timestamp("01 Jan 2018 00:00"), "Début", group = grpDate)
endDate    = input.time(timestamp("01 Jan 2030 00:00"), "Fin",   group = grpDate)

// =============================================================================
//  CALCULS
// =============================================================================

emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)

rsi = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
atr = ta.atr(atrLen)

htfTrendEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, emaTrendLen), lookahead = barmerge.lookahead_off)

// --- Filtres (chacun renvoie true s'il est désactivé) ---
trendBull = not useTrend200 or close > emaTrend
trendBear = not useTrend200 or close < emaTrend
htfBull   = not useHTF      or close > htfTrendEma
htfBear   = not useHTF      or close < htfTrendEma
rsiBull   = not useRsi      or rsi > rsiMid
rsiBear   = not useRsi      or rsi < rsiMid
adxOk     = not useAdx      or adx >= adxMin
inSession = not useSession  or not na(time(timeframe.period, sessionStr))
inDate    = not useDate     or (time >= startDate and time <= endDate)

tradeOk = inSession and inDate

// =============================================================================
//  SIGNAUX  — croisement des EMA rapide / lente
// =============================================================================

crossUp   = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)

longCond  = crossUp   and trendBull and htfBull and rsiBull and adxOk and tradeOk
shortCond = crossDown and trendBear and htfBear and rsiBear and adxOk and tradeOk

// =============================================================================
//  DIMENSIONNEMENT (basé sur le risque ATR)
// =============================================================================

stopDist = atr * atrStopMult
riskCash = strategy.equity * (riskPct / 100.0)
qty      = stopDist > 0 ? riskCash / stopDist : na

// =============================================================================
//  EXÉCUTION
// =============================================================================

// Sortie sur signal opposé
if exitOpp
    if strategy.position_size > 0 and crossDown
        strategy.close("Long", comment = "Signal opposé")
    if strategy.position_size < 0 and crossUp
        strategy.close("Short", comment = "Signal opposé")

if longCond and strategy.position_size <= 0
    entry = close
    sl    = entry - stopDist
    tp    = entry + stopDist * rrRatio
    strategy.entry("Long", strategy.long, qty = qty)
    strategy.exit("Sortie L", from_entry = "Long", stop = sl, limit = tp)

if shortCond and strategy.position_size >= 0
    entry = close
    sl    = entry + stopDist
    tp    = entry - stopDist * rrRatio
    strategy.entry("Short", strategy.short, qty = qty)
    strategy.exit("Sortie S", from_entry = "Short", stop = sl, limit = tp)

// --- Trailing stop ATR (optionnel) ---
var float longTrail  = na
var float shortTrail = na
if useTrail
    if strategy.position_size > 0
        nt = close - atr * trailMult
        longTrail := na(longTrail) ? nt : math.max(longTrail, nt)
        strategy.exit("Trail L", from_entry = "Long", stop = longTrail)
    else
        longTrail := na
    if strategy.position_size < 0
        nt = close + atr * trailMult
        shortTrail := na(shortTrail) ? nt : math.min(shortTrail, nt)
        strategy.exit("Trail S", from_entry = "Short", stop = shortTrail)
    else
        shortTrail := na

// =============================================================================
//  VISUEL
// =============================================================================
plot(emaFast,  "EMA rapide",  color = color.new(color.aqua, 0),    linewidth = 1)
plot(emaSlow,  "EMA lente",   color = color.new(color.orange, 0),  linewidth = 1)
plot(useTrend200 ? emaTrend : na, "EMA de fond", color = color.new(color.fuchsia, 0), linewidth = 2)

bgcolor(useSession and not inSession ? color.new(color.gray, 90) : na, title = "Hors session")
plotshape(longCond,  "Signal Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(shortCond, "Signal Short", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.small)

// =============================================================================
//  ALERTES
// =============================================================================
alertcondition(longCond,  "GOLD Long",  "Signal LONG XAUUSD")
alertcondition(shortCond, "GOLD Short", "Signal SHORT XAUUSD")
